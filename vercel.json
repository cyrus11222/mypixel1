{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "outputDirectory": "dist",
  "ignoreCommand": "node scripts/ignore-build.mjs",
  "functions": {
    "api/*.js": {
      "maxDuration": 60,
      "includeFiles": "*.html"
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/api/site"
    },
    {
      "source": "/index.html",
      "destination": "/api/site"
    },
    {
      "source": "/login",
      "destination": "/api/login"
    },
    {
      "source": "/login.html",
      "destination": "/api/login"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "same-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        }
      ]
    }
  ],
  "buildCommand": "node scripts/build.mjs"
}
