# Configure these in Vercel > Settings > Environment Variables.
# Public repositories are supported: user.txt is encrypted by the server.
# Keep keys in Vercel only. Never commit real secrets or copy them into HTML.
# Optional for this site; code defaults to the domain below.
APP_ORIGIN=https://www.mypixel.com.cn
AUTH_STORE=github
GITHUB_OWNER=cyrus11222
GITHUB_REPO=mypixel1
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# Run the same command AGAIN to generate a separate 64-hex encryption key.
# Keep a secure backup: replacing/losing this key makes existing accounts unreadable.
DATA_ENCRYPTION_KEY=
# For LOCAL preview only: AUTH_STORE=local, APP_ORIGIN=http://127.0.0.1:3000
# Vercel always uses GitHub storage and HTTPS cookies.
