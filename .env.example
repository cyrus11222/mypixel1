# Configure these in Vercel > Settings > Environment Variables.
# Do not put secrets in public/ or HTML. Use a PRIVATE account repository.
APP_ORIGIN=https://your-site.vercel.app
AUTH_STORE=github
GITHUB_OWNER=your-github-name
GITHUB_REPO=your-private-account-repository
GITHUB_BRANCH=main
GITHUB_TOKEN=
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
RATE_LIMIT_SECRET=
# For LOCAL preview only: AUTH_STORE=local, APP_ORIGIN=http://127.0.0.1:3000
# Vercel always uses GitHub storage and HTTPS cookies.
